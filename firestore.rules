rules_version = '2';

// Aturan keamanan Cloud Firestore untuk website Seblak UMKM
// Salin seluruh isi file ini ke Firebase Console > Firestore Database > Rules, lalu klik Publish.
// GANTI admin@contoh.com dengan email akun admin (sama dengan ADMIN_EMAIL di firebase-config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya akun admin yang sudah login yang boleh mengubah data
    function adminMasuk() {
      return request.auth != null
        && request.auth.token.email == "admin@contoh.com";
    }

    // Data teks toko: semua pengunjung boleh membaca, hanya admin yang boleh menulis
    match /umkm/{tokoId} {
      allow read: if true;
      allow write: if adminMasuk();

      // Foto hasil upload (disimpan per dokumen agar tidak melebihi batas 1 MB)
      match /foto/{fotoId} {
        allow read: if true;
        allow write: if adminMasuk();
      }
    }
  }
}
