rules_version = '2';

// Aturan keamanan Cloud Firestore untuk website Seblak UMKM
// Salin seluruh isi file ini ke Firebase Console > Firestore Database > Rules, lalu klik Publish.
// GANTI admin@contoh.com dengan email akun admin (sama dengan ADMIN_EMAIL di firebase-config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    // Data toko: semua pengunjung boleh MEMBACA, hanya admin yang sudah login boleh MENGUBAH
    match /umkm/{tokoId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "seblakumkm@gmail.com";
    }
  }
}
